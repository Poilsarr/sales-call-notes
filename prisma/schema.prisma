generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String         @id @default(cuid())
  clerkId                   String         @unique
  email                     String         @unique
  name                      String?
  avatar                    String?
  plan                      String         @default("FREE")
  credits                   Int            @default(5)
  paddleCustomerId          String?        @unique
  paddleSubscriptionId      String?
  subscriptionStatus        String?
  subscriptionPlan          String?
  trialEndsAt               DateTime?
  cancellationEffectiveDate DateTime?
  teamId                    String?
  team                      Team?          @relation("teamMembers", fields: [teamId], references: [id])
  teamRole                  String         @default("MEMBER")
  slackUserId               String?
  preferredTone             String?        @default("balanced")
  rubricEmphasis            String[]       @default([])
  ownedTeams                Team[]         @relation("teamOwner")
  calls                     Call[]
  assignedCalls             Call[]         @relation("callAssignments")
  comments                  CallComment[]
  auditLogs                 AuditLog[]
  apiKeys                   ApiKey[]
  notifications             Notification[]
  hasOnboarded              Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([email])
  @@index([teamId])
  @@index([clerkId])
  @@index([paddleCustomerId])
}

model Team {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  ownerId      String
  owner        User          @relation("teamOwner", fields: [ownerId], references: [id])
  members      User[]        @relation("teamMembers")
  calls        Call[]
  integrations Integration[]
  settings     String?
  brandColor   String? // hex e.g. "#5b21b6"; null = default indigo
  logoUrl      String? // https URL; null = default CP monogram
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([slug])
  @@index([ownerId])
}

model Call {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  teamId             String?
  team               Team?               @relation(fields: [teamId], references: [id])
  sharedWithTeam     Boolean             @default(false)
  isPublic           Boolean             @default(false)
  assigneeId         String?
  assignee           User?               @relation("callAssignments", fields: [assigneeId], references: [id])
  filename           String
  audioUrl           String?
  duration           Int?
  transcript         String?
  language           String              @default("en")
  summary            String?
  healthScore        Float?
  sentiment          String?
  crmSynced          Boolean             @default(false)
  crmProvider        String?
  crmRecordId        String?
  source             String              @default("upload")
  tags               String?
  embedding          Float[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  actionItems        ActionItem[]
  decisions          Decision[]
  nextSteps          NextStep[]
  speakers           Speaker[]
  analytics          Analytics?
  insight            CallInsight?
  competitorMentions CompetitorMention[]
  comments           CallComment[]

  @@index([userId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([createdAt])
}

model ActionItem {
  id          String    @id @default(cuid())
  callId      String
  call        Call      @relation(fields: [callId], references: [id])
  task        String
  owner       String
  due         String?
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([callId])
  @@index([status])
}

model Decision {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id])
  content   String
  category  String?
  createdAt DateTime @default(now())

  @@index([callId])
}

model NextStep {
  id          String    @id @default(cuid())
  callId      String
  call        Call      @relation(fields: [callId], references: [id])
  step        String
  date        String?
  status      String    @default("PENDING")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([callId])
  @@index([status])
}

model Speaker {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id])
  name      String?
  label     String
  segments  String?
  duration  Int?
  createdAt DateTime @default(now())

  @@index([callId])
}

model Analytics {
  id                   String   @id @default(cuid())
  callId               String   @unique
  call                 Call     @relation(fields: [callId], references: [id])
  talkRatio            String?
  speakerMetrics       Json?
  sentimentTimeline    Json?
  interruptions        Int?
  questionsAsked       Int?
  objections           String?
  budgetMentioned      Boolean  @default(false)
  timelineMentioned    Boolean  @default(false)
  decisionMakerPresent Boolean  @default(false)
  competitorMentioned  Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model Integration {
  id        String    @id @default(cuid())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id])
  provider  String
  config    String?
  enabled   Boolean   @default(true)
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([teamId])
  @@index([provider])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String   @unique
  requests    Int      @default(0)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
}

model CompetitorMention {
  id          String   @id @default(cuid())
  callId      String
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  competitor  String
  context     String?
  sentiment   String?
  mentionedBy String?
  timestamp   Float?
  createdAt   DateTime @default(now())

  @@index([callId])
  @@index([competitor])
  @@index([createdAt])
}

model CallInsight {
  id               String   @id @default(cuid())
  callId           String   @unique
  call             Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  sentimentScore   Float?
  talkRatio        Json?
  objections       Json?
  coachingNotes    Json?
  closeProbability Float?
  salesScorecard   Json?
  topics           Json?
  personalization  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([callId])
}

model CallComment {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([userId])
  @@index([createdAt])
}

model KnowledgeEntity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  value     String
  calls     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, value])
  @@index([userId, type, value])
}

model KnowledgeRelation {
  id           String   @id @default(cuid())
  userId       String
  fromEntityId String
  toEntityId   String
  relation     String
  calls        String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relation])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // human label, e.g. "Zapier integration"
  prefix     String    @unique // first 12 chars of the key, e.g. "cn_live_abcd"
  hash       String // sha-256 of the full key (never store the raw key)
  scope      String    @default("read") // "read" | "read_write"
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([prefix])
  @@index([revokedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([readAt])
}
