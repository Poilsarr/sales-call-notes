# =============================================================================
# Sentry (error monitoring — optional)
# =============================================================================
# Create a free Sentry account at https://sentry.io, create a new Next.js
# project, then copy the DSN from Project Settings > Client Keys (DSN).
# Without these vars the Sentry SDK is a no-op.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
