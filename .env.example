# =====================================================================
# CallNote Pro - Environment Variables
# =====================================================================
#
# Copy this file to `.env.local` for local development and fill in
# real values. Production secrets live in Vercel + GitHub Actions.
#
# Quick verification: `npx tsx scripts/check-env.ts`
# Platform setup guides: docs/INTEGRATIONS.md
#
# Format: groups are separated by `# ===========================`
# comments above each var explain what it does and where to get one.
# `npx tsx scripts/check-env.ts` will report which are missing.
#

# ===========================
# Core
# ===========================
# Public URL of the deployed app. Used for OAuth callbacks, Slack
# notification links, and CRM record references. Include the scheme.
NEXT_PUBLIC_APP_URL="https://sales-call-notes.vercel.app"

# Node environment. Local dev should set this to "development". Vercel
# injects "production" automatically for deployed environments.
NODE_ENV="development"

# ===========================
# Database (Neon PostgreSQL)
# ===========================
# Full Postgres connection string with `?sslmode=require` for Neon.
# Individual DB_* vars are supported as a fallback (assembled by
# src/lib/prisma.ts when DB_USER + DB_PASSWORD are present).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DB_USER=""
DB_PASSWORD=""
DB_HOST=""
DB_PORT="5432"
DB_NAME=""

# ===========================
# Auth (Clerk)
# ===========================
# Frontend-safe Clerk publishable key. Begins with `pk_test_` or `pk_live_`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Server-only Clerk secret key. Begins with `sk_test_` or `sk_live_`.
# Required for verifying session tokens on every API route.
CLERK_SECRET_KEY="sk_test_..."

# Optional. Webhook signing secret from Clerk Dashboard -> Webhooks.
# Used by /api/webhooks/clerk to verify incoming event payloads.
CLERK_WEBHOOK_SECRET="whsec_..."

# ===========================
# AI Providers
# ===========================
# OpenAI API key. Used for GPT-4o analysis, embeddings, and Whisper
# transcription fallback. https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Groq API key. Used for fast Whisper transcription. https://console.groq.com
GROQ_API_KEY="gsk_..."

# Hugging Face token. Used for diarization + open-source models.
# https://huggingface.co/settings/tokens
HF_TOKEN="hf_..."

# ===========================
# Integrations - HubSpot
# ===========================
# Public app Client ID. Get from HubSpot Developer Portal:
# https://developers.hubspot.com/ -> Apps -> Auth tab
HUBSPOT_CLIENT_ID=""

# Public app Client Secret. Revealed once at app creation. Store
# securely and rotate if leaked.
HUBSPOT_CLIENT_SECRET=""

# Optional override. Defaults to `${NEXT_PUBLIC_APP_URL}/integrations`
# which is the registered redirect URL in the HubSpot app.
HUBSPOT_REDIRECT_URI=""

# ===========================
# Integrations - Salesforce
# ===========================
# Connected App Consumer Key from Salesforce Setup -> App Manager.
SALESFORCE_CLIENT_ID=""

# Connected App Consumer Secret. Revealed by clicking "Manage Consumer
# Details" then "Use digital signatures" or "View secret".
SALESFORCE_CLIENT_SECRET=""

# Optional override. Defaults to `${NEXT_PUBLIC_APP_URL}/integrations`.
SALESFORCE_REDIRECT_URI=""

# Salesforce auth base URL. Use `https://login.salesforce.com` for
# production orgs, or `https://test.salesforce.com` for sandboxes.
# Also accepts SALESFORCE_AUTH_URL as a synonym used by the integrations
# route.
SALESFORCE_LOGIN_URL="https://login.salesforce.com"

# ===========================
# Integrations - Microsoft Teams
# ===========================
# Azure AD Application (client) ID from App Registration.
# Either TEAMS_* or MICROSOFT_* names are accepted; TEAMS_* wins.
TEAMS_CLIENT_ID=""

# Azure AD Client Secret value (not the Secret ID). Expires per the
# policy set in Certificates & secrets (default 6 months, max 24).
TEAMS_CLIENT_SECRET=""

# Optional. Defaults to `${NEXT_PUBLIC_APP_URL}/integrations`.
TEAMS_REDIRECT_URI=""

# Multi-tenant app tenant. `common` allows personal + work/school
# accounts. Set to a tenant GUID or `organizations` for single-tenant.
MICROSOFT_TENANT_ID="common"

# ===========================
# Integrations - Google (Calendar)
# ===========================
# OAuth 2.0 Client ID from Google Cloud Console -> APIs & Services ->
# Credentials. Configure Authorized redirect URI as
# `${NEXT_PUBLIC_APP_URL}/api/calendar/callback`.
GOOGLE_CLIENT_ID=""

# OAuth 2.0 Client Secret paired with the Client ID above.
GOOGLE_CLIENT_SECRET=""

# ===========================
# Slack
# ===========================
# Incoming Webhook URL. Create at https://api.slack.com/messaging/webhooks
# Stored server-side only - never accept this from the client.
SLACK_WEBHOOK_URL=""

# ===========================
# Upstash Redis (rate limit + BullMQ)
# ===========================
# REST URL from the Upstash console. Used for HTTP-based rate limiting
# that works on Vercel Edge runtime.
UPSTASH_REDIS_REST_URL=""

# REST token paired with the URL above. Long random string.
UPSTASH_REDIS_REST_TOKEN=""

# ===========================
# BullMQ (TCP Redis used by queue worker)
# ===========================
# ioredis connection details for the BullMQ worker process. Local dev
# defaults to localhost:6379; production uses the same Upstash instance
# with the rediss:// scheme.
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ===========================
# Paddle (billing)
# ===========================
# Server-side Paddle API key. Used by /api/paddle/webhook and
# subscription sync. https://vendors.paddle.com/authentication
PADDLE_API_KEY=""

# Browser-side Paddle client token. Starts with `live_` or `test_`.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""

# Webhook signing secret. Set when creating the subscription webhook
# destination in Paddle Dashboard -> Developer tools -> Webhooks.
PADDLE_WEBHOOK_SECRET=""

# ===========================
# Langfuse (LLM observability)
# ===========================
# Optional. Server-side Langfuse project secret key.
LANGFUSE_SECRET_KEY=""

# Optional. Public Langfuse project key (safe to expose to client).
LANGFUSE_PUBLIC_KEY=""

# Optional. Override the Langfuse base URL for EU region or self-host.
# Defaults to https://cloud.langfuse.com. LANGFUSE_HOST accepted too.
LANGFUSE_BASE_URL=""

# ===========================
# Sentry (error monitoring - optional)
# ===========================
# Browser DSN. Safe to expose; embeds the public key in the URL.
NEXT_PUBLIC_SENTRY_DSN=""

# Auth token used to upload source maps during `next build`.
SENTRY_AUTH_TOKEN=""

# Sentry organization slug from the dashboard URL.
SENTRY_ORG=""

# Sentry project slug from the dashboard URL.
SENTRY_PROJECT=""

# ===========================
# Misc runtime
# ===========================
# Optional. Override the temp directory used by the Python diarization
# worker when ffmpeg writes intermediate wav files. Defaults to /tmp.
TEMP="/tmp"
